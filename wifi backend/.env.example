# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/wifi_heatmap?retryWrites=true&w=majority

# Local fallback (for local development/testing without Atlas)
# MONGODB_URI=mongodb://127.0.0.1:27017/wifi_heatmap

# Cloudinary Storage Credentials (for floor map image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
